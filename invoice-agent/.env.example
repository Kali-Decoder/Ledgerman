PORT=3000
NODE_ENV=development

# Google OAuth
GOOGLE_CREDENTIALS_PATH=./credentials/credentials.json
GOOGLE_TOKEN_PATH=./credentials/token.json
# Add this exact URI on the Google OAuth client (Authorized redirect URIs)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/agent/auth/google/callback
# Ledgerman UI origin (post-login redirect)
UI_ORIGIN=http://localhost:5173

# Gmail — invoice tracking
GMAIL_USER=me
GMAIL_QUERY=(subject:invoice OR subject:receipt OR subject:billing) newer_than:30d
GMAIL_MAX_RESULTS=20

# Google Sheets (ID from the spreadsheet URL)
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Sheet1

# Slack (do not commit tokens)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL="#invoices"
SLACK_SIGNING_SECRET=

# Mock Stripe (no real charges)
MOCK_PAYMENT_DELAY_MS=800
